NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Upload de fotos (Ideias). Gerada sozinha pela Vercel ao conectar um Blob store ao
# projeto (Storage → Create → Blob) — não precisa criar/copiar nada manualmente em
# produção. Só é preciso preencher aqui pra rodar upload em localhost, com
# `vercel env pull .env.local` depois de ativar o Blob.
BLOB_READ_WRITE_TOKEN=
